{
  "name": "odds",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "check:spec": "python3 scripts/check_spec.py",
    "generate:messages": "node packages/messages/scripts/extract-messages.mjs",
    "generate:tokens": "node apps/playground/scripts/generate-tokens.mjs",
    "dev": "npm run dev -w @odds/playground --",
    "build:app": "npm run build -w @odds/playground --",
    "lint": "npm run lint -w @odds/playground --"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
